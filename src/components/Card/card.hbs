<div class='card {{#if isPremium}}card--premium{{/if}}' id='cards' data-id='{{id}}' data-images-json='{{{imagesJson}}}'>
    <div class='card__wrapper'>
        {{#if images}}
        <div class='card__indicators'>
            {{#each images}}
            <div class='card__indicator {{#if @first}}card__indicator--active{{/if}}'></div>
            {{/each}}
        </div>
        {{/if}}
        <img class='card__image' src='{{images.[0].imageUrl}}' alt='{{name}}' data-index='0' />
        <div class='card__gradient-overlay'></div>
    </div>
    {{#if noActions}}
    <div class='card__actions'>
        <button class='card__button card__button-reload' onClick='window.location.reload();'>&#8634;</button>
    </div>
    {{else}}
    <div class='card__actions'>
        <button class='card__button card__button-dislike'>
            <img src='/src/assets/card/cross.svg' alt='Dislike' />
        </button>
        <button class='card__button card__button-superLike'>&#9733;</button>
        <button class='card__button card__button-like'>&#9829;</button>
    </div>
    {{/if}}
</div>
