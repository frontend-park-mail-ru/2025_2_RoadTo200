<header class='header'>
    <div class='header__content'>
        <div class='header__left'>
            <button class='header__burger' id='burgerButton' aria-label='Открыть меню'>
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>

        <div class='header__right'>
            {{#if isAuthenticated}}
            <div class="header__superlikes" aria-label="Суперлайки">
                <span class="header__superlikes-icon" aria-hidden="true"></span>
                <span class="header__superlikes-count">{{superLikesRemaining}}/{{superLikesTotal}}</span>
            </div>
            <button class='header__bell-btn' id='notificationBellBtn' aria-label='Уведомления'>
                <img src='/src/assets/bell.svg' alt='Уведомления' class='header__bell-icon' />
                {{#if hasUnreadNotifications}}
                <span class='header__bell-badge'></span>
                {{/if}}
            </button>
            <button class='header__avatar-btn' id='userEmailBtn' aria-label='Профиль пользователя'>
                <div class='header__avatar {{#if isPremium}}header__avatar--premium{{/if}}'>
                    <img src='{{userPhoto}}' alt='{{userName}}' />
                </div>
            </button>
            {{else}}
            <a class='header__auth-link' Link href='/login'>Войти</a>
            {{/if}}
        </div>
    </div>
</header>
