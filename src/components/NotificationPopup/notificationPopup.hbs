<div class="notification-menu-overlay {{#unless isVisible}}hidden{{/unless}}" id="notificationMenuOverlay">
    <div class="notification-menu-popup">
        <div class="notification-menu-header">
            <h2 class="notification-menu-title">Уведомления</h2>
        </div>
        {{#if notifications.length}}
        <ul class="notification-menu-list">
            {{#each notifications}}
            <li class="notification-menu-item {{#if this.isRead}}notification-menu-item--read{{/if}}" data-id="{{this.id}}">
                <div class="notification-menu-icon">
                    {{#if (eq this.type "super_like")}}
                        <img src="/src/assets/menu/matches.svg" alt="Match" />
                    {{else if (eq this.type "like")}}
                        <img src="/src/assets/menu/matches.svg" alt="Like" />
                    {{else}}
                        <img src="/src/assets/menu/chats.svg" alt="Message" />
                    {{/if}}
                </div>

                <div class="notification-menu-content">
                    <p class="notification-menu-message">{{this.message}}</p>
                    <span class="notification-menu-time">{{this.time}}</span>
                </div>

                {{#unless this.isRead}}
                <button class="notification-mark-read-btn" data-notification-id="{{this.id}}" aria-label="Отметить как прочитанное">
                    <img src="/src/assets/eye.svg" alt="eye" />
                </button> 
                {{/unless}}
            </li>
            {{/each}}
        </ul>
        {{else}}
        <div class="notification-menu-empty">
            <p>Нет новых уведомлений</p>
        </div>
        {{/if}}
    </div>
</div>
