<div class='main-page__actions'>
    <button class='main-page__scroll-btn hidden' type='button' data-action='scroll-to-info'>
        <svg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'>
            <path d='M12 5V19M12 19L19 12M12 19L5 12' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/>
        </svg>
    </button>
    <button class='main-page__filter-btn' type='button' data-action='open-filter'>
        <img src='/src/assets/settings__filter.svg' alt='Фильтры' class='main-page__filter-icon' />
        Фильтры
    </button>
</div>

<div class='main-page-layout'>
    <div class='cards-container'>
        {{{cardsHtml}}}
    </div>
    <div class='card-info-panel' id='cardInfoPanel'>
        <!-- Информация о текущей карточке будет отображаться здесь -->
    </div>
</div>
